# ===========================================================================
# DocDock Environment Variables
# ===========================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env files containing real credentials.
#
# For Docker Compose (production):  docker compose up
# For Docker Compose (development): docker compose -f docker-compose.dev.yml up -d
#   then: npm run dev
# ===========================================================================

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------
# Local dev (no Docker): mongodb://localhost:27017/docdock
# Docker dev compose:    mongodb://docdock:docdock_dev_password@localhost:27017/docdock?authSource=admin
# Production Atlas:      mongodb+srv://user:pass@cluster.mongodb.net/docdock
MONGODB_URI=mongodb://localhost:27017/docdock

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
# Local dev (no Docker): redis://localhost:6379
# Docker dev compose:    redis://localhost:6379
# Production Upstash:    rediss://user:token@host.upstash.io:6380
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# JWT / Session secrets (minimum 32 characters each)
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace_with_min_32_char_random_string
JWT_REFRESH_SECRET=replace_with_min_32_char_random_string_2
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_min_32_char_random_string_3

# ---------------------------------------------------------------------------
# Kafka (optional — API works without Kafka; events are simply not published)
# ---------------------------------------------------------------------------
# Local dev compose:     localhost:9092
# Production Confluent:  broker.confluent.cloud:9092
# Production MSK:        b-1.cluster.xxx.kafka.us-east-1.amazonaws.com:9092
# Leave blank to disable Kafka
KAFKA_BROKERS=
KAFKA_CLIENT_ID=docdock-api
KAFKA_GROUP_ID_PREFIX=docdock
# Cloud Kafka SASL credentials (leave blank for local plaintext)
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# ---------------------------------------------------------------------------
# Docker Compose secrets (used by docker-compose.yml and docker-compose.dev.yml)
# These are used to configure the infrastructure containers, not the app
# ---------------------------------------------------------------------------
MONGO_ROOT_USERNAME=docdock
MONGO_ROOT_PASSWORD=docdock_dev_password
REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# Application URLs
# ---------------------------------------------------------------------------
APP_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_BYPASS_LOCATION=true

# ---------------------------------------------------------------------------
# Cloudinary (optional — image uploads disabled without these)
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Razorpay (optional — payment features disabled without these)
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ---------------------------------------------------------------------------
# SendGrid (optional — email notifications disabled without this)
# ---------------------------------------------------------------------------
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@docdock.com

# ---------------------------------------------------------------------------
# Google OAuth (optional — OAuth login disabled without these)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Twilio (optional — voice call features disabled without these)
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ---------------------------------------------------------------------------
# SMS Provider (optional — defaults to console logging)
# Options: console, fast2sms, msg91
# ---------------------------------------------------------------------------
SMS_PROVIDER=console
FAST2SMS_API_KEY=
MSG91_AUTH_KEY=

# ---------------------------------------------------------------------------
# Google Gemini AI (optional)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Development-only flags
# ---------------------------------------------------------------------------
# Auto-approve newly registered doctors (NEVER enable in production)
DEV_AUTO_VERIFY_DOCTOR=false